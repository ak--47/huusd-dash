{
  "name": "huusd-dash",
  "private": true,
  "type": "module",
  "description": "Harwood School Plans Explorer: an independent guide to the HUUSD FY28 consolidation decision",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs --axe-mobile",
    "format": "npx prettier@3 --write \"js/**/*.js\" \"data/**/*.js\" \"css/**/*.css\" \"scripts/**/*.mjs\" \"test/**/*.mjs\"",
    "staging:diff": "node scripts/staging-diff.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "playwright": "1.44.1"
  }
}
